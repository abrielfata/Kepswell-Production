# ============================================
# PRODUCTION ENVIRONMENT (Neon + Render + Vercel)
# ============================================

# Database - Neon PostgreSQL (connection string)
# Get this from Neon Console > Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxx.region.neon.tech/live_session_db?sslmode=require

# --- OR for local development, use individual vars: ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=live_session
# DB_USER=postgres
# DB_PASSWORD=your_password

# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=production

# ============================================
# JWT SECRET (generate a strong random string!)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET=your-strong-random-secret-here

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================
# OCR SPACE API
# ============================================
OCRSPACE_API_KEY=your-ocr-space-api-key

# ============================================
# FRONTEND URL (for CORS)
# ============================================
FRONTEND_URL=https://your-app.vercel.app
